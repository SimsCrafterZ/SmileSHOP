      "info": {
        "title": "Spooky Maze",
        "author": "calc84maniac",
        "description": "Happy Halloween! It's time for a raycaster game! This is a survival game filled with skellingtons, explosions, and of course, cats. Find the key and escape the maze, and if you rescue a cat you may get a reward... but watch your back! You never know what may be lurking in the shadows...",
        "category": ["game"],
        "console": ["3DS"],
        "icon_index": 2,
        "sheet_index": 0,
        "last_updated": "2015/10/15",
        "license": "Unlicensed",
        "version": "0.5.0"
      },
      "Spooky Maze": [
        {
          "type": "downloadFile",
          "file": "https://simscrafterz.github.io/SmileSHOP/files/spooky_maze/TSPOOKYMAZE.PRG",
          "output": "sdmc:/SmileSHOP/RAYCASTER/TSPOOKYMAZE.PRG"
        },
        {
          "type": "downloadFile",
          "file": "https://simscrafterz.github.io/SmileSHOP/files/spooky_maze/TRAYCAST.LIB",
          "output": "sdmc:/SmileSHOP/RAYCASTER/TRAYCAST.LIB"
        },
        {
          "type": "downloadFile",
          "file": "https://simscrafterz.github.io/SmileSHOP/files/spooky_maze/BGATE.GSV",
          "output": "sdmc:/SmileSHOP/RAYCASTER/BGATE.GSV"
        }
      ]
    },
    {
      "info": {
        "title": "Super Bearland",
        "author": "kantackistan",
        "description": "Bears have evolved the ability to shapeshift into anything (or anyone) you can imagine! (Or maybe your eyesight is just really poor?) Either way, one wrong step could be your last in the randomly generated world of Super Bearland. Hunt those beasts down before they hunt you!",
        "category": ["game"],
        "console": ["3DS"],
        "icon_index": 2,
        "sheet_index": 0,
        "last_updated": "2019/03/07",
        "license": "Unlicensed",
        "version": "2.0.0"
      },
      "Super Bearland": [
        {
          "type": "downloadFile",
          "file": "https://simscrafterz.github.io/SmileSHOP/files/super_bearland/TBEARLAND",
